{
  "name": "dsh-remote-terminal-controller",
  "version": "0.1.1",
  "description": "Terminal controller fork that routes terminals by Session: local Sessions keep the local PTY, mirrored remote Sessions use the plugin's SSH PTY route.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-api-terminal-controller": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-api-terminal-controller": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-terminal-controller": "0.2.1-rc.2"
  }
}
