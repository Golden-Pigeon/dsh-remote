{
  "name": "@goldenpigeon/dsh-remote-agent",
  "version": "0.2.3",
  "description": "DSH remote agent: loopback HTTP/SSE companion for the dsh-remote-local-plugin.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "remote-development",
    "remote-agent",
    "deepseek-harness"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    }
  },
  "devDependencies": {
    "@dsh-remote/protocol": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-user-approval": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/build-host.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Golden-Pigeon/dsh-remote.git",
    "directory": "packages/remote-agent"
  },
  "homepage": "https://github.com/Golden-Pigeon/dsh-remote#readme",
  "bugs": {
    "url": "https://github.com/Golden-Pigeon/dsh-remote/issues"
  },
  "author": "Golden-Pigeon <goldenpigeon2000@gmail.com>",
  "publishConfig": {
    "access": "public"
  }
}
